# Copy to .env before starting anything:  cp .env.example .env
#
# Compose reads .env automatically and substitutes ${VAR} in the compose files. Spring
# Boot separately maps env vars onto properties - SPRING_DATASOURCE_URL overrides
# spring.datasource.url - which is why these are SHOUTY_SNAKE.
#
# .env is gitignored because it holds real secrets; this template is committed so a new
# dev knows which vars exist. Config lives in the environment, not in code.

# --- global ---
COMPOSE_PROJECT_NAME=slackclone   # prefixes container/volume/network names so this stack can't collide with your other projects
TZ=UTC                            # containers run UTC; convert in the UI only. Sidesteps DST bugs entirely.
SPRING_PROFILES_ACTIVE=docker     # picks application-docker.yml, keeping laptop config and container config apart

# --- Postgres ---
# Relational store for anything needing real integrity: users, workspaces, membership.
# Foreign keys, unique constraints, transactions.
POSTGRES_HOST=postgres            # container name - Docker DNS resolves it. Not localhost.
POSTGRES_PORT=5432                # port inside the network
POSTGRES_HOST_PORT=5433           # published to Windows on 5433, since you already run Postgres on 5432
POSTGRES_DB=slackclone
POSTGRES_USER=slack_admin
POSTGRES_PASSWORD=change_me_in_prod_2f8a1c   # dev only; prod pulls this from Secrets Manager / Vault

# --- Mongo ---
# Messages live here. They're append-heavy, flexible documents (rich text blocks,
# attachments, reactions, thread replies) - modelling that relationally means half a dozen
# joins to render one message. One document = one read.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_HOST_PORT=27018             # 27017 is taken on your host too
MONGO_DB=slackclone_messages
# Root is admin-wide and only used by the init script. Two separate accounts on purpose:
# if the app credential leaks, it can touch this one database and nothing else.
MONGO_ROOT_USER=mongo_root
MONGO_ROOT_PASSWORD=change_me_in_prod_7b3e9d
# What message-service actually connects with - readWrite scoped to MONGO_DB.
MONGO_USER=slack_app
MONGO_PASSWORD=change_me_in_prod_4d8c1a

# --- Redis ---
# Three jobs: login rate-limit counters, presence, and pub/sub fan-out between
# realtime-service replicas. Refresh tokens deliberately live in Postgres instead - see
# the note in TokenService.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=change_me_in_prod_5c4d2e

# --- Kafka ---
# Decouples the write path. Posting a message doesn't call search and notifications
# directly - if search were down, posting would fail. One event, N independent consumers.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_PORT=29092             # host listener kept distinct from the in-cluster one (9092)

# --- OpenSearch ---
# "messages containing 'deployment' from @alice in #backend last month" needs an inverted
# index with relevance scoring. SQL LIKE '%x%' can't rank and can't use an index.
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_HOST_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m   # capped so the whole stack fits in 16 GB

# --- object storage (S3 API) ---
# Uploads never belong in a database: it bloats every backup and can't be CDN-served.
# Locally this is SeaweedFS, which speaks S3; in prod it's real AWS S3. The Java side
# uses AWS SDK v2 against both, so only the endpoint changes. (MinIO would also have
# worked - its images are no longer published on Docker Hub.)
S3_ENDPOINT=http://seaweedfs:8333        # in-cluster endpoint the services call
S3_HOST_PORT=8333                        # published so the browser can fetch uploaded files
S3_MASTER_PORT=9333                      # SeaweedFS admin UI, useful for poking around
S3_REGION=us-east-1                      # SeaweedFS ignores it, but the SDK requires one
S3_ACCESS_KEY=slack_s3_key               # must match infra/seaweedfs/s3-identities.json
S3_SECRET_KEY=change_me_in_prod_9a7f3b
S3_BUCKET=slack-uploads
# Separate from S3_ENDPOINT on purpose. Services resolve "seaweedfs" via Docker DNS, but
# a browser can't - it needs a host-reachable URL. Same split exists in prod, where this
# becomes the CloudFront domain.
S3_PUBLIC_BASE_URL=http://localhost:8333/slack-uploads

# --- JWT ---
# Short access token limits damage if it leaks; long refresh token keeps people logged in.
JWT_SECRET=dev_only_secret_please_replace_with_a_256_bit_random_value_0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900        # 15 min
JWT_REFRESH_TTL_SECONDS=604800    # 7 days
JWT_ISSUER=slack-clone

# --- service ports ---
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
WORKSPACE_SERVICE_PORT=8082
MESSAGE_SERVICE_PORT=8083
REALTIME_SERVICE_PORT=8084
FILE_SERVICE_PORT=8085
SEARCH_SERVICE_PORT=8000
NOTIFICATION_SERVICE_PORT=8001

# --- notification-service -----------------------------------------------------------
# The From: address on outgoing mail.
MAIL_FROM=Slack Clone <no-reply@slack-clone.local>
# Base URL for links inside emails. This is the address a RECIPIENT'S BROWSER can reach, not
# one the container uses - an invitation link pointing at http://frontend:80 is unopenable by
# the person who receives it, which is the mistake this comment exists to prevent.
APP_BASE_URL=http://localhost:3000
FRONTEND_PORT=3000

# --- mail (dev) ---
# Mailpit captures outgoing mail with a web UI, so invite emails are visible and nothing
# real gets sent.
SMTP_HOST=mailhog
SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686
